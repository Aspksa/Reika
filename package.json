{
  "name": "reika",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Рэйка Амацухара — локальное пространство",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --config vite.config.mjs",
    "build": "node scripts/build-web.mjs && node scripts/versions.mjs sync",
    "check:build": "node scripts/build-web.mjs --check",
    "check": "node scripts/versions.mjs check && node --check web/app.js && node --check vite.config.mjs && node --check scripts/build-web.mjs && node --check scripts/versions.mjs",
    "versions:sync": "node scripts/versions.mjs sync",
    "versions:check": "node scripts/versions.mjs check",
    "versions:bump": "node scripts/versions.mjs bump",
    "test:browser": "node tests/browser_smoke.cjs",
    "test:versions": "node --test tests/versions.test.mjs"
  },
  "devDependencies": {
    "vite": "8.3.5"
  }
}
